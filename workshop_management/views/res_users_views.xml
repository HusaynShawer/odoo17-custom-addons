<odoo>

    <record id="view_users_form_inherit_workshop" model="ir.ui.view">
        <field name="name">res.users.form.inherit.workshop</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Workshop" name="workshop">
                    <group>
                        <field name="is_technician"/>
                    </group>
                    <field name="ticket_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="state" widget="badge"/>
                            <field name="customer_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>