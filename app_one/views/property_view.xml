<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class = "custom_header" decoration-danger = "(is_late)">
                <field name="name"/>
                <field name="data_availability"/>
                <field name="expected_price"/>
                <field name="is_late"/>
                <field name = "sell_price"/>
                <field name = "diff"/>
                <field name ="state" />
                <field name="garden"/>
                <field name = "bedrooms" optional = "1" />
                <field name = "garage" optional = "1" />
                <field name = "owner_id"/>
            </tree>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <header>
                        <field name = "state" widget="statusbar" options ="{'clickable':1}"/>
                        <button name = "action" type = "object" class = "btn_primary" string = "Action"/>
                        <button name = "action_draft" type = "object" class = "btn_primary" string = "set to draft"
                        invisible = "state == 'draft'"/>
                        <button name = "action_confirmed" type = "object" class = "btn_primary" string = "set to confirmed"
                        invisible = "state != 'draft'"/>
                        <button name = "action_sold" type = "object" class = "btn_primary" string = "set to Sold"
                        invisible = "state != 'confirmed'"/>
                    </header>

                    <div>
                        <label for = "name"/>
                        <h1>
                            <field name = "name"/>
                        </h1>
                    </div>
                    <group>
                        <group  string = "Genral info">
                            <field name="data_availability"/>
                            <field name="expected_selling_date"/>
                            <field name="is_late"/>
                            <field name="expected_price"/>
                            <field name = "sell_price"/>
                            <field name="garden"/>
                        </group>
                        <group string = "Aditional info">
                            <field name = "owner_id"/>
                            <field name = "owner_adress"/>
                            <field name = "owner_phone"/>
                            <field name = "bedrooms" />
                             <field name = "garage"/>
                            <field name = "garden_orientation"/>
                            <field name ="tag_ids" widget = "many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string = "Bedroms">
                            <field name = "line_ids">
                                <tree editable = "button">
                                    <field name ="description"/>
                                    <field name = "area"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class = "oe_chatter">
                    <field name = "message_follower_ids"/>
                    <field name = "activity_ids"/>
                    <field name = "message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name = "data_availability"/>
                <field name = "name"/>
                <filter name="is_garden" string = "With Garden" domain = "[('garden','=','True')]"/>
                <filter name="is_not_garden" string = "With No Garden" domain = "[('garden','=','Fasle')]"/>
                <filter name="groub_garden" string = "Garden" context = "{'geoub_by':'garden'}"/>


            </search>
        </field>
    </record>


    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">close property</field>
        <field name="model_id" ref ="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name ="code">
            action = records.close_action()
        </field>
    </record>

    <record id="sellig_data_is_late" model="ir.cron">
        <field name ="name">Check: is sellig date</field>
        <field name = "model_id" ref ="model_property"/>
        <field name="state">code</field>
        <field name = "code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <menuitem id="property_menu_item"
              name="Properties"
              parent="properties_menu"
              action="property_action"
            sequence="1"/>
</odoo>