<odoo>
    <record id = "tag_tree_view" model = "ir.ui.view">
        <field name = "name">tag tree</field>
        <field name = "model">tag</field>
        <field name = "arch" type = "xml">
            <tree>
                <field name = "name"/>
<!--                <field name = "phone"/>-->
<!--                <field name = "email"/>-->
<!--                <field name = "adress"/>-->
            </tree>
        </field>

    </record>
        <record id = "tag_form_view" model = "ir.ui.view">
        <field name = "name">tag form</field>
        <field name = "model">tag</field>
        <field name = "arch" type = "xml">
            <form>
                <sheet>
                    <div class = "on_title">
                        <label for = "name"/>
                        <h1>
                           <field name = "name"/>
                        </h1>
                    </div>
                    <group>
<!--                        <group>-->
<!--                        </group>-->
<!--&lt;!&ndash;                        <group>&ndash;&gt;-->
<!--&lt;!&ndash;                            <field name = "property_ids" widget = "many2many_tags"/>&ndash;&gt;-->
<!--&lt;!&ndash;                        </group>&ndash;&gt;-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

<record id="tag_action" model="ir.actions.act_window">
    <field name="name">Tag</field>
    <field name="res_model">tag</field>
    <field name="view_mode">tree,form</field>
</record>

    <menuitem id="tag_menu_item"
              name="tags"
              parent="configuration_menu"
              action="tag_action"/>
</odoo>